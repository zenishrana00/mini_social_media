# ==============================================================================
# Mini Social Media Platform - Environment Configuration Template
# Copy this file to '.env' and fill in the values for your environment.
# ==============================================================================

# Server Environment & Port
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# For Local MongoDB: mongodb://127.0.0.1:27017/mini_social_media
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/mini_social_media?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/mini_social_media

# JSON Web Token (JWT) Configuration
# In production, use a strong, cryptographically secure random string (at least 32 characters)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRE=30d

# Cross-Origin Resource Sharing (CORS) Configuration (Optional)
# In production, set to your frontend domain (e.g., https://my-social-app.com).
# For multiple domains, separate by commas. Leave blank to allow same-origin/all in development.
CLIENT_URL=http://localhost:5000
